# Production Environment Variables
# Copy to .env.production and adjust values

# API Target for proxy (your backend API)
API_TARGET=https://admin.vitrine.gallery

# Server port (default 5173)
PORT=5173

# Node environment
NODE_ENV=production

# GitHub Container Registry image tag
# Use 'branch-production' for latest production branch build
# Or specific tag like 'v1.0.0' for releases
IMAGE_TAG=branch-production