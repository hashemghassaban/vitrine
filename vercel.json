{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "yarn install --frozen-lockfile",
  "buildCommand": "yarn build:ssr",
  "outputDirectory": "dist/client",
  "functions": {
    "api/render.js": {
      "includeFiles": "dist/server/**",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/fa",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://admin.vitrine.gallery/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://admin.vitrine.gallery/api/:path*"
    },
    {
      "source": "/captcha/:path*",
      "destination": "https://admin.vitrine.gallery/captcha/:path*"
    },
    {
      "source": "/healthz",
      "destination": "/api/render?__ssr_path=/healthz"
    },
    {
      "source": "/:path*",
      "destination": "/api/render?__ssr_path=/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
