{
  "name": "vitrine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "tsc -b && vite build",
    "build:ssr": "npm run build && vite build --ssr src/entry-server.tsx --outDir dist/server && npm run build:server",
    "build:server": "tsc server/middleware.ts --outDir dist/server --target es2020 --module esnext --moduleResolution node --skipLibCheck --allowSyntheticDefaultImports",
    "preview": "vite preview",
    "start": "node dist/server/middleware.js"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "antd": "^5.28.1",
    "axios": "^1.13.2",
    "express": "^4.22.1",
    "html-react-parser": "^5.2.11",
    "less-loader": "^12.3.0",
    "lottie-react": "^2.4.1",
    "react": "^19.2.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.2.0",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.9.6",
    "styled-components": "^5.3.11",
    "swiper": "^12.0.3",
    "truncate-html": "^1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/styled-components": "^5.1.36",
    "@types/swiper": "^5.4.3",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "less": "^4.4.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "npm:rolldown-vite@7.2.2"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.2"
  }
}
